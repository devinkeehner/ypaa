# ── Cash registration codes ────────────────────────────────────────────────
# External issuer used for generated cash/scholarship registration codes.
ISSUER_SERVICE_BASE_URL=
ISSUER_SERVICE_API_KEY=
ISSUER_EVENT_SLUG=necypaa-xxxvi
# Local committee code. This is accepted directly; the external issuer is
# checked only when no local/environment code matches.
CASH_ACCESS_CODE=
CASH_ACCESS_CODE_MAX_REDEMPTIONS=1

# ── Site and storage ───────────────────────────────────────────────────────
DATABASE_URI=
PAYLOAD_SECRET=
# Enable the official Payload MCP endpoint at /api/mcp. After enabling, create
# a scoped key in the Payload MCP API Keys collection in Admin.
PAYLOAD_ENABLE_MCP=false
# Optional value used by external MCP proxies; the official endpoint validates
# keys created in Payload Admin rather than reading this value directly.
PAYLOAD_MCP_API_KEY=

# Dedicated server-to-server key used by the separate Registration Site to
# read, price, fulfill Payload merchandise, and report paid registrations and
# breakfast tickets. Never expose this in a browser.
REGISTRATION_SITE_API_KEY=
ENABLE_R2=false
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BACKFILL_SECRET=
